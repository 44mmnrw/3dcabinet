{
  "compilerOptions": {
    /* Основные настройки */
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Строгие проверки */
    "strict": true,                      // Включает: strictNullChecks, strictFunctionTypes, strictBindCallApply, strictPropertyInitialization, noImplicitThis, alwaysStrict, noImplicitAny
    "noUnusedLocals": true,             // Запрещает неиспользуемые локальные переменные
    "noUnusedParameters": true,         // Запрещает неиспользуемые параметры
    "noFallthroughCasesInSwitch": true, // Запрещает fallthrough в switch
    "noUncheckedIndexedAccess": true,   // Строгая проверка доступа к массивам/объектам
    
    /* Дополнительные строгие проверки */
    "noImplicitReturns": true,          // Функции должны явно возвращать значение
    "noPropertyAccessFromIndexSignature": true, // Требует использовать [] для индексных сигнатур (userData['key'] вместо userData.key)
    "exactOptionalPropertyTypes": true,  // Строгая проверка optional свойств (undefined !== отсутствие свойства)

    /* Дополнительные проверки */
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    /* Пути и алиасы */
    "baseUrl": ".",
    "paths": {
      "@/*": ["resources/frontend/*"],
      "@public/*": ["public/js/*"]
    },

    /* Типы */
    "types": ["vite/client"]
  },
  "include": [
    "resources/frontend/**/*",
    "resources/frontend/**/*.ts",
    "resources/frontend/**/*.tsx"
    // vite.config.ts обрабатывается через tsconfig.node.json (project references)
  ],
  "exclude": [
    "node_modules",
    "public/build",
    "vendor"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}

